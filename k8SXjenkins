pipeline {
    agent any

    environment {
        DOCKER_USER = "your_dockerhub_username"
        IMAGE_NAME = "java-hello-world"
        K8S_CONFIG = "k8s-deploy.yaml"
    }

    stages {
        stage('Checkout') {
            steps {
                git 'https://github.com/your-username/java-hello.git'
            }
        }

        stage('Build & Push') {
            steps {
                echo 'Skipping build/push steps for brevity (Assumed complete)...'
            }
        }

        stage('Deploy to K8s') {
            steps {
                echo 'Deploying to Kubernetes Cluster...'
                // Ensure kubectl is pointed to your Kind cluster
                sh "kubectl apply -f ${K8S_CONFIG}"
            }
        }

        stage('Verify Deployment') {
            steps {
                echo 'Checking Pod Status...'
                // Wait for the rollout to finish
                sh "kubectl rollout status deployment/java-app-deployment"
                
                // List the running pods
                sh "kubectl get pods -l app=java-hello"
            }
        }
    }
}
